          </p>
          <div class="btn-row">
            <a href="#portfolio" class="btn btn-primary">See my work</a>
            <a href="mailto:hello@avamarina.com" class="btn btn-outline">Get in touch</a>
          </div>
        </div>
        <div class="avatar-wrap">
          <div class="avatar-blob">AM</div>
        </div>
      </div>
    </div>
  </section>
 
  <!-- ABOUT -->
  <section id="about">
    <div class="container">
      <div class="about-grid">
        <div>
          <p class="section-label">About me</p>
          <h2 class="section-title">Color, craft,<br>and intention.</h2>
          <p class="about-text">
            I'm a multidisciplinary creative with a love for bold color,
