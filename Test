            intention to everything I make.
          </p>
          <p class="about-text">
            Based in Karlstad, Sweden. Open to freelance projects,
            collaborations, and the occasional creative adventure.
          </p>
          <div class="skill-tags">
            <span class="tag" style="background:var(--pink-light);color:#993556">Illustration</span>
            <span class="tag" style="background:var(--teal-light);color:#0F6E56">Branding</span>
            <span class="tag" style="background:var(--purple-light);color:#3C3489">UI Design</span>
            <span class="tag" style="background:var(--amber-light);color:#854F0B">Photography</span>
            <span class="tag" style="background:var(--coral-light);color:#993C1D">Art Direction</span>
            <span class="tag" style="background:var(--pink-light);color:#993556">Typography</span>
          </div>
        </div>
        <div class="stats-col">
          <div class="stat-card">
            <div class="stat-icon" style="background:var(--pink-light)">🎨</div>
            <div>
              <div class="stat-num" style="color:var(--pink)">40+</div>
              <div class="stat-label">Projects completed</div>
            </div>
          </div>
          <div class="stat-card">
            <div class="stat-icon" style="background:var(--teal-light)">🌍</div>
            <div>
              <div class="stat-num" style="color:var(--teal)">12</div>
              <div class="stat-label">Countries worked with</div>
            </div>
          </div>
          <div class="stat-card">
            <div class="stat-icon" style="background:var(--purple-light)">⭐</div>
            <div>
              <div class="stat-num" style="color:var(--purple)">5+</div>
              <div class="stat-label">Years of experience</div>
            </div>
          </div>
          <div class="stat-card">
            <div class="stat-icon" style="background:var(--amber-light)">☕</div>
            <div>
              <div class="stat-num" style="color:var(--amber)">∞</div>
              <div class="stat-label">Cups of coffee consumed</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
 
  <!-- PORTFOLIO -->
  <section id="portfolio">
    <div class="container">
      <div class="portfolio-header">
        <div>
          <p class="section-label">Portfolio</p>
          <h2 class="section-title">Selected works</h2>
        </div>
        <div class="filter-row">
          <button class="filter-btn active" onclick="filterCards(this,'all')">All</button>
          <button class="filter-btn" onclick="filterCards(this,'branding')">Branding</button>
          <button class="filter-btn" onclick="filterCards(this,'illustration')">Illustration</button>
          <button class="filter-btn" onclick="filterCards(this,'photo')">Photography</button>
          <button class="filter-btn" onclick="filterCards(this,'ui')">UI</button>
        </div>
      </div>
 
      <div class="portfolio-grid" id="portfolio-grid">
 
        <a href="#" class="portfolio-card" data-cat="branding">
          <div class="card-thumb" style="background:var(--pink-light)">🌸</div>
          <div class="card-body">
            <p class="card-cat">Branding</p>
            <h3 class="card-title">Floralis — brand identity</h3>
            <p class="card-desc">Full branding suite for a Karlstad flower studio</p>
          </div>
        </a>
 
        <a href="#" class="portfolio-card" data-cat="photo">
          <div class="card-thumb" style="background:var(--teal-light)">📷</div>
          <div class="card-body">
            <p class="card-cat">Photography</p>
            <h3 class="card-title">Light &amp; Form — portrait series</h3>
            <p class="card-desc">Studio photography project exploring light and shadow</p>
          </div>
        </a>
 
        <a href="#" class="portfolio-card" data-cat="illustration">
          <div class="card-thumb" style="background:var(--purple-light)">🌿</div>
          <div class="card-body">
            <p class="card-cat">Illustration</p>
            <h3 class="card-title">Bloom — pattern collection</h3>
            <p class="card-desc">Surface design and botanical illustration series</p>
          </div>
        </a>
 
        <a href="#" class="portfolio-card" data-cat="ui">
          <div class="card-thumb" style="background:var(--amber-light)">📱</div>
          <div class="card-body">
            <p class="card-cat">UI Design</p>
            <h3 class="card-title">Moodboard app — interface concept</h3>
            <p class="card-desc">Mobile app UI design for creative inspiration</p>
          </div>
        </a>
 
        <a href="#" class="portfolio-card" data-cat="branding">
          <div class="card-thumb" style="background:var(--coral-light)">🏷️</div>
          <div class="card-body">
            <p class="card-cat">Branding</p>
            <h3 class="card-title">Kava Studio — visual identity</h3>
            <p class="card-desc">Logo, type, and packaging for a coffee brand</p>
          </div>
        </a>
 
        <a href="#" class="portfolio-card" data-cat="illustration">
          <div class="card-thumb" style="background:var(--pink-light)">✏️</div>
          <div class="card-body">
            <p class="card-cat">Illustration</p>
            <h3 class="card-title">Editorial — magazine spreads</h3>
            <p class="card-desc">Commissioned illustrations for a Swedish lifestyle magazine</p>
          </div>
        </a>
 
      </div>
    </div>
  </section>
 
  <!-- FOOTER STRIP -->
  <footer class="footer-strip">
    © 2026 AVA Marina. All rights reserved. — More sections coming soon.
  </footer>
 
  <script>
    function filterCards(btn, cat) {
      document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      document.querySelectorAll('.portfolio-card').forEach(card => {
        card.style.display = (cat === 'all' || card.dataset.cat === cat) ? 'block' : 'none';
      });
    }
  </script>
 
</body>
</html>
